import tp.*

//Punto 3

test "Un kilo de plomo no es mayor a un kilo de plumas según su peso."{
	assert.that(!balanza.esMayor(kiloDePlomo,kiloDePluma,{objeto =>objeto.peso()}))
}
test "Un kilo de plumas no es mayor a un kilo de plomo según su peso."{
	assert.that(!balanza.esMayor(kiloDePluma,kiloDePlomo,{objeto =>objeto.peso()}))

}
test "Un kilo de plumas es igual a un kilo de plomo según su peso."{
	assert.that(balanza.esIgual(kiloDePluma,kiloDePlomo,{objeto =>objeto.peso()}))
}
test "Un kilo de plumas es mayor a un kilo de plomo según su volumen."{
	assert.that(balanza.esMayor(kiloDePluma,kiloDePlomo,{objeto =>objeto.volumen()}))
}


//Punto 5

test "Un objeto es menor según su peso que el mismo objeto dentro de la caja."{
	cajaDeMadera.cambiarAlgo(kiloDePlomo)
	assert.that(balanza.esMayor(cajaDeMadera,kiloDePlomo,{objeto =>objeto.peso()}))
}
test "El peso de la caja vacía es de 0.2 kilos."{
	cajaDeMadera.cambiarAlgo(vacio)
	assert.that(cajaDeMadera.peso() == 0.2)
}



